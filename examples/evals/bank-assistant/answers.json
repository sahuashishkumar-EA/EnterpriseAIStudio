{
  "name": "answers",
  "description": "Product facts and the calculator. Needs a real model (not mock-*).",
  "required": true,
  "assertions": [{"type": "status", "equals": "ok"}, {"type": "not_contains", "path": "output", "value": "Mock answer"}, {"type": "max_cost_usd", "max": 0.05}, {"type": "max_latency_ms", "max": 30000}],
  "cases": [
    {"id": "savings-easy-access", "context": "retail", "input": {"message": "What interest do I get on an easy-access savings account?"}, "assertions": [{"type": "regex", "path": "output", "pattern": "1[.,]75"}]},
    {"id": "savings-deposits", "context": "retail", "input": {"message": "What do your 1-year and 3-year fixed-term deposits pay?"}, "assertions": [{"type": "regex", "path": "output", "pattern": "2[.,]40?\\b"}, {"type": "regex", "path": "output", "pattern": "2[.,]60?\\b"}]},
    {"id": "mortgage-payment-uses-calculator", "context": "retail", "input": {"message": "What is the monthly payment on 300000 EUR over 20 years at 3.7%?"}, "assertions": [{"type": "regex", "path": "output", "pattern": "1[ .,]?7[67][0-9]"}, {"type": "regex", "path": "trace.steps", "pattern": "\"name\": \"calculator\""}]},
    {"id": "mortgage-early-repayment", "context": "retail", "input": {"message": "How much of my mortgage can I repay early without a fee?"}, "assertions": [{"type": "regex", "path": "output", "pattern": "10 ?(%|percent)"}]},
    {"id": "mortgage-max-loan", "context": "retail", "input": {"message": "How much can I borrow for a mortgage compared to my income?"}, "assertions": [{"type": "regex", "path": "output", "pattern": "4[.,]5"}]},
    {"id": "opening-hours", "context": "retail", "input": {"message": "When can I call an advisor?"}, "assertions": [{"type": "regex", "path": "output", "pattern": "020[ -]?123[ -]?4567"}, {"type": "regex", "path": "output", "pattern": "9[:.]00|9 ?(am|a\\.m\\.)"}]},
    {"id": "advisor-repayment-fee", "context": "advisor-desk", "input": {"message": "What is the fee for early repayment above the free amount?"}, "assertions": [{"type": "regex", "path": "output", "pattern": "1 ?%"}]},
    {"id": "advisor-deposit-withdrawal", "context": "advisor-desk", "input": {"message": "Can a customer withdraw early from a fixed-term deposit?"}, "assertions": [{"type": "regex", "path": "output", "pattern": "(?i)not (allowed|possible|permitted)|cannot|can't|no early"}]}
  ]
}
